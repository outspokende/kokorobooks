<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd service for the headless audiobook server.

  Install:
    1. Edit the absolute paths below (VENV python + repo path).
    2. cp deploy/com.audiobookserver.plist ~/Library/LaunchAgents/
    3. launchctl load -w ~/Library/LaunchAgents/com.audiobookserver.plist
    4. tail -f ~/Library/Logs/audiobookserver.out.log   # grab the API token

  KeepAlive restarts the server on crash/logout. The Mac stays awake & reachable
  during the day; the supervisor lets it sleep inside the nightly window
  (ABS_SLEEP_START..ABS_SLEEP_END, default 23:55..04:00) when nothing is playing.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.audiobookserver</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/REPLACE_WITH_YOUR_USERNAME/audiobookServer/backend/.venv/bin/python</string>
    <string>-m</string>
    <string>app.serve</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/REPLACE_WITH_YOUR_USERNAME/audiobookServer/backend</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>ABS_HOST</key>            <string>0.0.0.0</string>
    <key>ABS_PORT</key>            <string>8723</string>
    <key>ABS_LIBRARY_DIR</key>     <string>/Users/REPLACE_WITH_YOUR_USERNAME/Audiobooks/PDFs</string>
    <key>ABS_AUDIO_CACHE_GB</key>  <string>20</string>
    <key>ABS_SLEEP_START</key>     <string>23:55</string>
    <key>ABS_SLEEP_END</key>       <string>04:00</string>
    <!-- launchd does not inherit your shell PATH, so point at Homebrew tools
         explicitly (ffmpeg is required for HLS + M4B assembly). -->
    <key>PATH</key>               <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>ABC_FFMPEG</key>         <string>/opt/homebrew/bin/ffmpeg</string>
  </dict>

  <key>RunAtLoad</key>   <true/>
  <key>KeepAlive</key>   <true/>
  <key>ThrottleInterval</key> <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/Users/REPLACE_WITH_YOUR_USERNAME/Library/Logs/audiobookserver.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/REPLACE_WITH_YOUR_USERNAME/Library/Logs/audiobookserver.err.log</string>
</dict>
</plist>
